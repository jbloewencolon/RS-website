{
  "name": "relational-sovereignty-website",
  "private": true,
  "version": "0.2.0",
  "description": "Static site checks: HTML validation and automated accessibility (axe-core) audit.",
  "scripts": {
    "build": "node scripts/prerender.mjs",
    "build:hugo": "node scripts/build-hugo.mjs",
    "check": "node scripts/check-origins.mjs && node scripts/check-pages.mjs",
    "check:origins": "node scripts/check-origins.mjs",
    "check:responsive": "node responsive-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "html-validate": "^11.6.2",
    "playwright": "^1.47.0"
  }
}
